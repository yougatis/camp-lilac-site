---
import Base from '../layouts/Base.astro';
import { rooms } from '../data/rooms';
import { safaris } from '../data/safaris';
import { site } from '../data/site';
import Crumbs from '../components/Crumbs.astro';
import { offers, offersActive, OFFER_MONTH, OFFER_START, OFFER_END } from '../data/offers';

const title = 'Book a Stay or Safari at Camp Lilac, Mikumi';
const description =
  'Request availability for luxury tents and cabins at Camp Lilac plus a Mikumi safari. Nothing to pay to enquire; we reply within 4 hours with one total price.';
const crumbs = [{ name: 'Book direct', href: '/book' }];

// Requests go to /api/booking (functions/api/booking.js), which saves them in the Google Sheet
// "Camp Lilac - Website booking requests" and emails info@camp-lilac.com. The thank-you page then
// offers WhatsApp. If sending fails, the guest is offered WhatsApp straight away.
const BOOKING_API = '/api/booking';
---

<Base {title} {description} breadcrumbs={crumbs} dark>
  <section class="hero hero--inner">
    <div class="hero-media"><img src="/images/rooms/mv-cabin-1-1600.webp" srcset="/images/rooms/mv-cabin-1-800.webp 800w, /images/rooms/mv-cabin-1-1200.webp 1200w, /images/rooms/mv-cabin-1-1600.webp 1600w" sizes="100vw" alt="The bathtub in the Mountain View Cabin at Camp Lilac, looking out to the Mikumi mountain ridge" width="1600" height="1200" fetchpriority="high" /></div>
    <div class="wrap hero-content">
      <div>
        <Crumbs items={crumbs} />
        <h1><span class="w"><span>Request a booking</span></span></h1>
        <p class="lead">Nothing to pay yet. Tell us your dates and we reply {site.replyTime} with availability, one total price and a safari suggestion. A deposit then secures your room.</p>
      </div>
      {offersActive ? (
        <div class="hero-side" data-offer><b>November safari deals</b>2-day safari: free pickup from Morogoro<br />3–4 day safari: free train ticket + pickup</div>
      ) : (
        <div class="hero-side"><b>Book direct</b>Breakfast &amp; dinner included<br />One total price, no fees</div>
      )}
    </div>
  </section>

  <div style="height:56px"></div>
  <div class="wrap split" style="padding-bottom:var(--section)">
    <form class="form" id="booking-form" method="post" action="/thank-you" data-api={BOOKING_API} data-whatsapp={site.whatsapp} data-offer-month={OFFER_MONTH} data-offer-start={OFFER_START} data-offer-end={OFFER_END} data-offers={JSON.stringify(offersActive ? offers.map((o) => ({ title: o.title, text: o.text })) : [])}>
      <p class="offer-banner" id="offer-banner" hidden></p>
      <input type="hidden" name="offer" value="" />
      <div class="row">
        <label>Name <input name="name" required autocomplete="name" /></label>
        <label>Email <input name="email" type="email" required autocomplete="email" /></label>
      </div>
      <div class="row">
        <label>WhatsApp number <input name="phone" type="tel" required autocomplete="tel" placeholder="+255 ..." pattern="[+]?[0-9 ()-]{7,20}" title="Include your country code, e.g. +255 or +44" /></label>
        <label>Country <input name="country" required autocomplete="country-name" /></label>
      </div>
      <div class="row">
        <label>Check-in <input name="checkin" type="date" required /></label>
        <label>Check-out <input name="checkout" type="date" required /></label>
      </div>
      <div class="row">
        <label>Adults <input name="adults" type="number" min="1" value="2" required /></label>
        <label>Children (ages) <input name="children" placeholder="e.g. 2 (ages 6 and 10)" /></label>
      </div>
      <label>Room
        <select name="room">
          <option value="">Let us suggest</option>
          {rooms.map((r) => <option value={r.slug}>{r.name}{r.price ? ` — from US$${r.price}/night` : ''}</option>)}
        </select>
      </label>
      <label>Safari
        <select name="safari">
          <option value="none">No safari, stay only</option>
          {safaris.map((s) => <option value={s.slug}>{s.name}</option>)}
          <option value="custom">Custom — I’ll describe it below</option>
        </select>
      </label>
      <label>Arriving by
        <select name="arrival">
          <option>From Dar es Salaam by SGR train (please collect me in Morogoro)</option>
          <option>From Dar es Salaam by car (please arrange it)</option>
          <option>From Zanzibar by ferry, then train</option>
          <option>From Zanzibar by ferry, then car</option>
          <option>From Zanzibar by plane (please book the flight)</option>
          <option>From the airport in Dar es Salaam</option>
          <option>Own car / self-drive</option>
          <option>Bus to Mikumi town</option>
          <option>Not sure yet — please advise</option>
        </select>
      </label>
      <label>Anything else you would like us to organise <textarea name="message" placeholder="Anything at all — a birthday dinner, a night in Zanzibar, a different route, dietary needs, onward travel… We can organise it."></textarea></label>
      <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
      <button class="btn" type="submit">Send request</button>
      <p class="form-status" id="form-status" role="status" hidden></p>
      <p class="meta">Free, no obligation. We reply {site.replyTime} with availability and one total price. We only use your details to answer this request.</p>
    </form>

    <aside class="aside">
      <h3>Prefer to chat?</h3>
      <p><a href={site.whatsapp}>WhatsApp {site.phoneDisplay}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      {offersActive && <div data-offer>
        <h3>November safari deals</h3>
        <ul>
          <li>2-day safari: free transfer Morogoro SGR → Mikumi, worth US$75 (one way)</li>
          <li>3- or 4-day safari: free economy train tickets Dar → Morogoro (worth US$10–20 for two) + transfer (one way)</li>
          <li>For safaris starting in November 2026, booked direct. Room-only stays don’t include free transfers.</li>
        </ul>
        <p style="font-size:0.95rem"><a href="/offers" style="border-bottom:1px solid var(--lilac)">How the offers work</a></p>
      </div>}
      <h3>Children</h3>
      <p style="font-size:0.95rem">Under 4 stay free, ages 4–11 half price.</p>
      <h3>We organise anything</h3>
      <p style="font-size:0.95rem">Train, car, ferry or flights from Zanzibar, extra nights, special occasions — don’t be shy to ask. Tell us what you want and how you want to travel, and we arrange it.</p>
    </aside>
  </div>

  <script>
    const form = document.getElementById('booking-form') as HTMLFormElement;
    const params = new URLSearchParams(location.search);
    for (const key of ['room', 'safari', 'checkin', 'checkout', 'adults']) {
      const v = params.get(key);
      const el = form.elements.namedItem(key) as HTMLInputElement | HTMLSelectElement | null;
      if (v && el) el.value = v;
    }
    const OFFERS = JSON.parse(form.dataset.offers || '[]');
    const banner = document.getElementById('offer-banner') as HTMLElement;
    const offerField = form.elements.namedItem('offer') as HTMLInputElement;
    const safariSel = form.elements.namedItem('safari') as HTMLSelectElement;
    const daysOf = (slug: string) => parseInt(slug, 10) || 0;
    const checkinEl = form.elements.namedItem('checkin') as HTMLInputElement;
    const { offerStart = '', offerEnd = '', offerMonth = '' } = form.dataset;
    const today = new Date().toISOString().slice(0, 10);
    const showOffer = () => {
      if (!OFFERS.length || today > offerEnd) { banner.hidden = true; offerField.value = ''; return; } // deals over: say nothing
      const d = daysOf(safariSel.value);
      const o = d >= 3 ? OFFERS[1] : d === 2 ? OFFERS[0] : null;
      const ci = checkinEl.value;
      const ok = !!o && today <= offerEnd && (!ci || (ci >= offerStart && ci <= offerEnd));
      offerField.value = ok ? o.title : '';
      banner.hidden = !o;
      if (!o) return;
      banner.innerHTML = ok
        ? `<strong>Offer applied: ${o.title}</strong> — ${o.text}`
        : `<strong>No safari deal for these dates</strong> — the free transfer and train ticket are only for safaris starting in ${offerMonth}.`;
    };
    safariSel.addEventListener('change', showOffer);
    checkinEl.addEventListener('change', showOffer);
    showOffer();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const status = document.getElementById('form-status') as HTMLElement;
    const shown = (name: string) => {
      const el = form.elements.namedItem(name) as HTMLSelectElement | null;
      return el ? el.options[el.selectedIndex]?.text || '' : '';
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      if (data.website) { location.href = '/thank-you'; return; } // honeypot: bots get a fake success
      const room = shown('room');
      const safari = shown('safari');
      const text = `Booking request from camp-lilac.com\nName: ${data.name}\nEmail: ${data.email}\nWhatsApp: ${data.phone || '-'}\nCountry: ${data.country || '-'}\nDates: ${data.checkin} to ${data.checkout}\nAdults: ${data.adults}, children: ${data.children || '0'}\nRoom: ${room}\nSafari: ${safari}\nSafari deal: ${data.offer || '-'}\nArriving by: ${data.arrival}\nNotes: ${data.message || '-'}`;
      const wa = `${form.dataset.whatsapp}?text=${encodeURIComponent(text)}`;
      try { sessionStorage.setItem('cl-wa-text', text); } catch {}
      const api = form.dataset.api;
      if (!api) { location.href = wa; return; }
      btn.disabled = true; btn.textContent = 'Sending…'; status.hidden = true;
      try {
        const res = await fetch(api, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, room, safari }),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok || !out.ok) throw new Error(out.error || String(res.status));
        location.href = '/thank-you';
      } catch {
        btn.disabled = false; btn.textContent = 'Send request';
        status.hidden = false;
        status.innerHTML = `Sorry, your request didn’t go through. <a href="${wa}">Send it on WhatsApp instead</a> — it’s already written for you.`;
      }
    });
  </script>
</Base>
