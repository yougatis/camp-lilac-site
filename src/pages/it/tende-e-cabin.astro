---
// Italian version of /rooms. Hand-written; ask an Italian speaker to read it once before promoting it.
import Base from '../../layouts/Base.astro';
import Crumbs from './_Crumbs.astro';
import Photo from '../../components/Photo.astro';
import { rooms, cover } from '../../data/rooms';
import { site } from '../../data/site';
import { offersActive } from '../../data/offers';
import { L, roomIt, viewIt, unitsIt, replyIt, MESE_ANNO } from '../../data/i18n-it';

const title = 'Tende di lusso e cabin a Mikumi | Camp Lilac';
const description =
  'Cinque alloggi appena fuori dal Parco Nazionale di Mikumi: tende di lusso e cabin con bagno privato, aria condizionata e terrazza. Colazione e cena incluse.';
const crumbs = [{ name: 'Tende di lusso e cabin', href: L('/rooms') }];
const wa = `${site.whatsapp}?text=${encodeURIComponent('Buongiorno! Vorremmo informazioni sulla disponibilità a Camp Lilac. Siamo in ... persone (adulti/bambini), date: ...')}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Tende di lusso e cabin a Camp Lilac',
  inLanguage: 'it',
  itemListElement: rooms.map((r, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}${L(`/rooms/${r.slug}`)}`, name: r.name })),
};
---

<Base {title} {description} {schema} lang="it" ogImage="/images/rooms/jungle-tent-1-1600.jpg" breadcrumbs={crumbs} dark>
  <section class="hero hero--inner">
    <div class="hero-media"><img src="/images/rooms/jungle-tent-1-1600.webp" srcset="/images/rooms/jungle-tent-1-800.webp 800w, /images/rooms/jungle-tent-1-1200.webp 1200w, /images/rooms/jungle-tent-1-1600.webp 1600w" sizes="100vw" alt="Una tenda di lusso di Camp Lilac sulla sua pedana rialzata in legno" width="1600" height="1200" fetchpriority="high" /></div>
    <div class="wrap hero-content">
      <div>
        <Crumbs items={crumbs} />
        <h1 style="max-width:17ch"><span class="w"><span>Tende di lusso e cabin&nbsp;</span></span><br /><span class="w"><em style="color:#e4d9f7">vicino al Parco Nazionale di Mikumi</em></span></h1>
        <p class="lead">Due cabin con tetto di paglia e otto tende di lusso in tela, appena fuori dal parco. Ognuna con bagno privato, aria condizionata e terrazza privata. Colazione e cena incluse.</p>
      </div>
      <div class="hero-side"><b>Check-in {site.checkIn}</b>Check-out {site.checkOut}<br />Sotto i 4 anni gratis · 4–11 anni metà prezzo</div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <ul class="room-rows">
        {rooms.map((r) => (
          <li class="room-row">
            <a class="room-row-media rv" href={L(`/rooms/${r.slug}`)}>
              <Photo src={cover(r)} alt={roomIt(r).imageAlt} caption={roomIt(r).caption} ratio="landscape" />
            </a>
            <div>
              <span class="numeral rv">{r.numeral}</span>
              <h2 class="rv rv-d1"><a href={L(`/rooms/${r.slug}`)} style="color:inherit">{r.name}</a>{roomIt(r).gloss && <small style="display:block;font-size:0.55em;font-weight:400;opacity:0.8">({roomIt(r).gloss})</small>}</h2>
              <p class="meta rv rv-d1">{unitsIt(r)} · {roomIt(r).sleeps} · {viewIt(r)}</p>
              <p class="price rv rv-d2">{r.price ? <span>Da US${r.price} <small>a notte</small></span> : <span>Tariffe su richiesta</span>}</p>
              <p class="rv rv-d2">{roomIt(r).summary}</p>
              <a class="link rv rv-d3" href={L(`/rooms/${r.slug}`)}>Dettagli e foto</a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--sand section--tight">
    <div class="wrap split--aside" style="display:grid">
      <div class="article">
        <h2 class="rv">Buono a sapersi</h2>
        <ul class="rv rv-d1">
          <li>Ogni tariffa prenotata direttamente con noi comprende colazione e cena al ristorante. Il pranzo, o qualsiasi pasto in più, costa 15 dollari a persona. Le bevande sono escluse. Nei pacchetti safari tutti i pasti sono inclusi.</li>
          <li>I bambini da 0 a 3 anni non pagano, dai 4 agli 11 pagano la metà della tariffa adulti, dai 12 anni tariffa adulti. Colazione e cena sono incluse anche per i bambini; sotto i 4 anni mangiano gratis. I bambini sotto i 2 anni non possono partecipare ai game drive.</li>
          <li>Ogni alloggio, tende di lusso comprese, ha aria condizionata, bagno privato e terrazza privata.</li>
          <li>Wi-Fi al ristorante e al bar. Le tende di lusso sono volutamente senza connessione.</li>
          <li>I pickup dalla stazione SGR di Morogoro, da Dar es Salaam e dall’aeroporto sono disponibili a pagamento.{offersActive && <span data-offer> Il transfer da Morogoro è gratuito solo se prenotate direttamente con noi un safari di 2 o più giorni con partenza a {MESE_ANNO} (solo all’andata; con il safari di 3 o 4 giorni sono gratuiti anche i biglietti del treno SGR in economica da Dar es Salaam a Morogoro).</span>} I pasti si servono nel <a href={L('/restaurant')}>ristorante</a> di fronte alla catena dei monti Mikumi.</li>
          <li>Il campo è appena fuori dal Parco Nazionale di Mikumi, a pochi minuti dall’ingresso e a 2 km dalla strada principale. Volete sapere come ci confrontiamo con i lodge dentro il parco o con gli hotel nel paese di Mikumi? Leggete <a href={L('/where-to-stay-in-mikumi')}>dove dormire a Mikumi</a> (in inglese).</li>
          <li>Non si accettano animali. Il campo non è ancora accessibile in sedia a rotelle.</li>
        </ul>
      </div>
      <aside class="aside rv rv-d2">
        <h3>Non sapete quale scegliere?</h3>
        <p>Le coppie di solito prendono la Mountain View Cabin o una Luxury Mountain View Tent. Le famiglie prendono una Luxury Family Tent. Diteci chi viene e vi suggeriamo la sistemazione giusta. Rispondiamo {replyIt}.</p>
        <a class="btn" href={wa} rel="noopener">Chiedete la disponibilità su WhatsApp</a>
        <p style="margin-top:12px;font-size:0.9rem">oppure <a href={L('/book')}>compilate il modulo di richiesta</a></p>
      </aside>
    </div>
  </section>

  <section class="section on-dark band">
    <div class="wrap">
      <h2 class="rv">Cena di fronte ai monti Mikumi. Poi solo la savana.</h2>
      <p class="lead rv rv-d1">Diteci le date e chi viene. Rispondiamo in giornata con la disponibilità, il prezzo totale e una proposta di safari.</p>
      <div class="btn-row rv rv-d2">
        <a class="btn btn--fill" href={wa} rel="noopener">WhatsApp {site.phoneDisplay}</a>
        <a class="btn btn--light" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>
</Base>
