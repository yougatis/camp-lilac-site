---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import Photo from '../../components/Photo.astro';
import Price from '../../components/Price.astro';
import { rooms, cover } from '../../data/rooms';
import { site } from '../../data/site';

const title = 'Luxury Safari Tents & Cabins in Mikumi | Camp Lilac';
const description =
  'Five room types across ten units near Mikumi National Park: a mountain-view cabin, a jungle cabin and luxury safari tents with private bathrooms, A/C and private decks. Breakfast included.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Rooms and tents at Camp Lilac',
  itemListElement: rooms.map((r, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}/rooms/${r.slug}`, name: r.name })),
};
---

<Base {title} {description} {schema} breadcrumbs={[{ name: 'Stay', href: '/rooms' }]} dark>
  <section class="hero hero--inner">
    <div class="hero-media"><img src="/images/rooms/jungle-tent-1-1600.webp" srcset="/images/rooms/jungle-tent-1-800.webp 800w, /images/rooms/jungle-tent-1-1600.webp 1600w" sizes="100vw" alt="A luxury safari tent at Camp Lilac on its raised wooden deck" width="1600" height="1200" fetchpriority="high" /></div>
    <div class="wrap hero-content">
      <div>
        <p class="label">Stay</p>
        <h1><span class="w"><span>Tents &amp;&nbsp;</span></span><span class="w"><em style="color:#e4d9f7">cabins</em></span></h1>
        <p class="lead">Two thatched cabins and eight luxury canvas tents. Every one with an private bathroom, air conditioning and a private deck. Breakfast included.</p>
      </div>
      <div class="hero-side"><b>Check-in {site.checkIn}</b>Check-out {site.checkOut}<br />Under-4s free · 4–11 half price</div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <ul class="room-rows">
        {rooms.map((r) => (
          <li class="room-row">
            <a class="room-row-media rv" href={`/rooms/${r.slug}`}>
              <Photo src={cover(r)} alt={r.imageAlt} caption={r.caption} ratio={r.images.length ? 'landscape' : 'landscape'} />
            </a>
            <div>
              <span class="numeral rv">{r.numeral}</span>
              <h2 class="rv rv-d1"><a href={`/rooms/${r.slug}`} style="color:inherit">{r.name}</a></h2>
              <p class="meta rv rv-d1">{r.units > 1 ? `${r.units} units` : 'One of a kind'} · {r.sleeps} · {r.view === 'mountain' ? 'Mikumi mountain ridge view' : 'Among the trees'}</p>
              <p class="price rv rv-d2"><Price price={r.price} /></p>
              <p class="rv rv-d2">{r.summary}</p>
              <a class="link rv rv-d3" href={`/rooms/${r.slug}`}>Details &amp; photos</a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--sand section--tight">
    <div class="wrap split--aside" style="display:grid">
      <div class="article">
        <h2 class="rv">Good to know</h2>
        <ul class="rv rv-d1">
          <li>Breakfast is included in every rate. Lunch and dinner are served in the restaurant and charged per meal.</li>
          <li>Children 0–3 stay free, ages 4–11 pay half the adult rate, from 12 adult rate. Meals for children are charged per meal.</li>
          <li>Every room, tents included, has air conditioning, an private bathroom and a private deck.</li>
          <li>Wi-Fi at the restaurant and bar. The tents are intentionally offline.</li>
          <li>Pickups from Morogoro SGR station, Dar es Salaam and the airport. Free Morogoro transfer when you book a 2+ day safari.</li>
          <li>No pets. The camp is not yet wheelchair accessible.</li>
        </ul>
      </div>
      <aside class="aside rv rv-d2">
        <h3>Not sure which?</h3>
        <p>Couples usually take the Mountain View Cabin or a Mountain View Tent. Families take a Family Tent. Tell us who is coming and we will suggest the fit.</p>
        <a class="btn" href="/book">Ask about availability</a>
      </aside>
    </div>
  </section>

  <CtaBand />
</Base>
