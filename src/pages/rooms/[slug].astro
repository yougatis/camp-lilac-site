---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import Photo from '../../components/Photo.astro';
import Price from '../../components/Price.astro';
import Crumbs from '../../components/Crumbs.astro';
import { rooms, cover } from '../../data/rooms';
import { site } from '../../data/site';
import { offersActive } from '../../data/offers';

export function getStaticPaths() {
  return rooms.map((r) => ({ params: { slug: r.slug }, props: { room: r } }));
}
const { room } = Astro.props;
// "Other rooms": the three that follow this one in the list (cyclic), so every room — the Family Tent included — gets
// the same number of links from room pages.
const idx = rooms.findIndex((r) => r.slug === room.slug);
const others = [1, 2, 3].map((n) => rooms[(idx + n) % rooms.length]);
const kind = room.tier === 'tent' ? 'Luxury Safari Tent' : 'Private Cabin';
const imgBase = cover(room).replace(/-1600\.jpg$/, '');
const crumbs = [{ name: 'Stay', href: '/rooms' }, { name: room.name, href: `/rooms/${room.slug}` }];

const title = room.metaTitle ?? `${room.name} – ${kind} in Mikumi | Camp Lilac`;
const trim = (t: string) => (t.length > 158 ? t.slice(0, 157).replace(/\s+\S*$/, '') + '…' : t);
const description = room.metaDescription ?? trim(`${room.summary}${room.price ? ` From US$${room.price}/night.` : ''}`);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HotelRoom',
  name: room.name,
  description: room.summary,
  image: room.images.map((i) => new URL(i, site.url).href),
  url: `${site.url}/rooms/${room.slug}`,
  bed: { '@type': 'BedDetails', typeOfBed: room.bed },
  occupancy: { '@type': 'QuantitativeValue', maxValue: room.slug === 'luxury-family-tent' ? 4 : 2 },
  amenityFeature: room.highlights.map((h) => ({ '@type': 'LocationFeatureSpecification', name: h, value: true })),
  containedInPlace: { '@id': `${site.url}/#camp` },
  ...(room.price && { offers: { '@type': 'Offer', price: room.price, priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: `${site.url}/book?room=${room.slug}`, priceSpecification: { '@type': 'UnitPriceSpecification', price: room.price, priceCurrency: 'USD', unitText: 'per night, breakfast and dinner included' } } }),
};
---

<Base {title} {description} {schema} ogImage={cover(room)} breadcrumbs={crumbs} dark>
  <section class="hero hero--inner">
    <div class="hero-media"><img src={`${imgBase}-1600.webp`} srcset={`${imgBase}-800.webp 800w, ${imgBase}-1200.webp 1200w, ${imgBase}-1600.webp 1600w`} sizes="100vw" alt={room.imageAlt} width="1600" height="1200" fetchpriority="high" /></div>
    <div class="wrap hero-content">
      <div>
        <Crumbs items={crumbs} />
        <p class="label">{room.numeral} · {kind}</p>
        <h1><span class="w"><span>{room.name}</span></span></h1>
        <p class="lead">{room.summary}</p>
      </div>
      <div class="hero-side"><b><Price price={room.price} /></b>{room.sleeps}<br />Breakfast &amp; dinner included</div>
    </div>
  </section>

  {room.images.length > 1 && (
    <section class="section section--tight">
      <div class="wrap">
        <div class="gallery">
          {room.images.slice(1).map((src, i) => <Photo src={src} alt={room.imageAlts?.[i + 1] ?? `${room.name} at Camp Lilac, Mikumi — photo ${i + 2} of ${room.images.length}`} ratio="landscape" />)}
        </div>
        <div class="gallery-foot">
          <p class="gallery-hint">Drag or use the arrows to see more</p>
          <div class="gallery-nav"><button class="prev" type="button" aria-label="Previous photo">←</button><button class="next" type="button" aria-label="Next photo">→</button></div>
        </div>
      </div>
    </section>
  )}

  <section class="section section--tight">
    <div class="wrap split--aside" style="display:grid">
      <div class="article">
        {room.description.map((p, i) => <p class={`rv rv-d${Math.min(i, 2)}`}>{p}</p>)}
        <h2 class="rv">In the {room.tier === 'tent' ? 'tent' : 'cabin'}</h2>
        <ul class="rv rv-d1">{room.highlights.map((h) => <li>{h}</li>)}</ul>
        <h2 class="rv">Pair it with a safari</h2>
        <p class="rv rv-d1">Our guides run game drives in Mikumi National Park straight from the camp, in a private open-roof 4×4.{offersActive && <span data-offer> Book a safari of two days or more with us for November 2026 and the Morogoro SGR station transfer is free (with three or four days we also pay your train ticket from Dar es Salaam). Booking the room only? Then the transfer is charged.</span>} See the <a href="/safaris">safari packages</a>, or how a stay works <a href="/safari-from-dar-es-salaam">from Dar es Salaam</a> and <a href="/safari-from-zanzibar">from Zanzibar</a>.</p>
        <p class="rv rv-d1">Meals are served in the <a href="/restaurant">restaurant</a> facing the Mikumi mountain ridge; breakfast and dinner are included when you book direct.</p>
      </div>
      <aside class="aside rv rv-d2">
        <p class="aside-price"><Price price={room.price} /></p>
        <ul>
          <li>{room.sleeps}</li>
          <li>{room.bed}</li>
          <li>{room.units > 1 ? `${room.units} units of this type` : 'One unit — book early'}</li>
          <li>Private bathroom · air conditioning · private deck</li>
          <li>Breakfast &amp; dinner included · lunch US$15 per person</li>
          <li>Check-in {site.checkIn} · check-out {site.checkOut}</li>
        </ul>
        <a class="btn btn--fill" href={`/book?room=${room.slug}`}>Request this room</a>
        <p style="margin:14px 0 0;font-size:0.9rem;text-align:center">or <a href={site.whatsapp} style="border-bottom:1px solid var(--lilac)">WhatsApp us</a></p>
      </aside>
    </div>
  </section>

  <section class="section section--sand">
    <div class="wrap">
      <h2 class="rv" style="margin-bottom:40px">Other rooms</h2>
      <div class="tiles tiles--3">
        {others.map((r, i) => (
          <a class={`tile rv rv-d${i}`} href={`/rooms/${r.slug}`}>
            <Photo src={cover(r)} alt={r.imageAlt} caption={r.numeral} />
            <h3>{r.name}</h3>
            <p><Price price={r.price} /></p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title={`Book the ${room.name}`} />
</Base>
