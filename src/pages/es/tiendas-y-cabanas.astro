---
// Spanish version of /rooms (tents & cabins overview). Hand-written; ask a Spanish speaker to read it once before promoting it.
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Photo from '../../components/Photo.astro';
import { rooms, cover } from '../../data/rooms';
import { site } from '../../data/site';
import { offersActive } from '../../data/offers';

const title = 'Tiendas de lujo y cabañas en Mikumi | Camp Lilac';
const description =
  'Cinco alojamientos junto al Parque Nacional de Mikumi: tiendas de lujo y cabañas con baño privado, aire acondicionado y terraza. Desayuno y cena incluidos.';
const crumbs = [{ name: 'Alojamiento', href: '/rooms' }, { name: 'Tiendas y cabañas', href: '/es/tiendas-y-cabanas' }];
const alternates = [
  { lang: 'en', href: '/rooms' },
  { lang: 'it', href: '/it/tende-e-cabin' },
  { lang: 'fr', href: '/fr/tentes-et-cabines' },
  { lang: 'de', href: '/de/zelte-und-cabins' },
  { lang: 'es', href: '/es/tiendas-y-cabanas' },
];
const replyTime = site.replyTime === 'within 4 hours during the day' ? 'en menos de 4 horas durante el día' : site.replyTime;
const wa = `${site.whatsapp}?text=${encodeURIComponent('Hola. Nos gustaría saber la disponibilidad en Camp Lilac. Somos ... adultos y ... niños, fechas: ...')}`;

// Spanish copy per room type; names (product names, kept in English), prices, units and photos come from src/data/rooms.ts.
const es: Record<string, { gloss: string; sleeps: string; summary: string; alt: string; caption: string }> = {
  'mountain-view-cabin': {
    gloss: 'cabaña con vista a los montes',
    sleeps: '2 adultos',
    summary: 'Nuestro mejor alojamiento: una cabaña privada con techo de paja frente a la cordillera de Mikumi, con una terraza amplia, cama king con dosel y una bañera con vistas.',
    alt: 'Bañera exenta en la Mountain View Cabin de Camp Lilac, con la cordillera de Mikumi a través de la ventana',
    caption: 'El baño, 17:50',
  },
  'luxury-mountain-view-tent': {
    gloss: 'tienda de lujo con vista a los montes',
    sleeps: '2 adultos',
    summary: 'Nuestras tiendas de lujo más nuevas: la misma tienda de lona que las Luxury Jungle Tents, orientada hacia la cordillera de Mikumi, con el mejor atardecer de Mikumi desde su propia terraza.',
    alt: 'Luxury Mountain View Tent en Camp Lilac, frente a la cordillera de Mikumi',
    caption: 'Frente a la cordillera de Mikumi',
  },
  'jungle-cabin': {
    gloss: 'cabaña entre los árboles',
    sleeps: '2 adultos',
    summary: 'Una cabaña privada con techo de paja entre los árboles: una larga terraza perimetral, cama con dosel, baño de mármol y los sonidos de la sabana de Mikumi alrededor.',
    alt: 'Jungle Cabin en Camp Lilac, con su techo de paja y escalera de madera entre los árboles de miombo',
    caption: 'Desde el sendero, 07:15',
  },
  'luxury-jungle-tent': {
    gloss: 'tienda de lujo entre los árboles',
    sleeps: '2 adultos',
    summary: 'La estancia de safari clásica: una tienda de lujo de lona sobre una plataforma de madera, con cama con dosel, baño privado, aire acondicionado y animales pasando junto a la escalera.',
    alt: 'Tienda de lujo de safari en Camp Lilac sobre una plataforma de madera bajo los árboles, cerca del Parque Nacional de Mikumi',
    caption: 'Tienda dos, media mañana',
  },
  'luxury-family-tent': {
    gloss: 'tienda de lujo familiar',
    sleeps: '2 adultos + 2 niños (hasta 4 huéspedes)',
    summary: 'Una tienda de lujo amplia para familias: espacio para los padres y dos niños, baño privado, aire acondicionado y terraza privada. Los menores de 4 años no pagan; de 4 a 11, la mitad de la tarifa de adulto.',
    alt: 'La terraza privada de una Luxury Family Tent en Camp Lilac, con vista a la sabana',
    caption: 'Espacio para cuatro',
  },
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Tiendas de lujo y cabañas en Camp Lilac',
  inLanguage: 'es',
  itemListElement: rooms.map((r, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}/rooms/${r.slug}`, name: r.name })),
};
---

<Base {title} {description} {schema} lang="es" {alternates} ogImage="/images/rooms/mv-cabin-1-1600.jpg" breadcrumbs={crumbs} dark>
  <section class="hero hero--inner">
    <div class="hero-media"><img src="/images/rooms/jungle-tent-1-1600.webp" srcset="/images/rooms/jungle-tent-1-800.webp 800w, /images/rooms/jungle-tent-1-1200.webp 1200w, /images/rooms/jungle-tent-1-1600.webp 1600w" sizes="100vw" alt="Una tienda de lujo de safari en Camp Lilac sobre su plataforma de madera elevada" width="1600" height="1200" fetchpriority="high" /></div>
    <div class="wrap hero-content">
      <div>
        <Crumbs items={crumbs} />
        <h1 style="max-width:17ch"><span class="w"><span>Tiendas de lujo y cabañas&nbsp;</span></span><br /><span class="w"><em style="color:#e4d9f7">junto al Parque Nacional de Mikumi</em></span></h1>
        <p class="lead">Dos cabañas con techo de paja y ocho tiendas de lujo de lona, justo fuera del parque, a minutos de la puerta. Todas con baño privado, aire acondicionado y terraza privada. Desayuno y cena incluidos al reservar directamente.</p>
      </div>
      <div class="hero-side"><b>Entrada {site.checkIn}</b>Salida {site.checkOut}<br />Menores de 4 gratis · 4–11 mitad de precio</div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="meta" style="margin-bottom:28px"><a href="/rooms">Leer esta página en inglés</a> · Nuestras otras páginas en español: <a href="/es/safari-desde-zanzibar">Safari desde Zanzíbar</a> · <a href="/es/safaris-mikumi">Safaris en Mikumi</a> · <a href="/es/como-llegar">Cómo llegar</a></p>
      <ul class="room-rows">
        {rooms.map((r) => {
          const t = es[r.slug];
          return (
            <li class="room-row">
              <a class="room-row-media rv" href={`/rooms/${r.slug}`}>
                <Photo src={cover(r)} alt={t?.alt ?? r.imageAlt} caption={t?.caption ?? r.caption} ratio="landscape" />
              </a>
              <div>
                <span class="numeral rv">{r.numeral}</span>
                <h2 class="rv rv-d1"><a href={`/rooms/${r.slug}`} style="color:inherit">{r.name}</a>{t && <small style="display:block;font-size:0.55em;font-weight:400;opacity:0.8">({t.gloss})</small>}</h2>
                <p class="meta rv rv-d1">{r.units > 1 ? `${r.units} unidades` : 'Única'} · {t?.sleeps ?? r.sleeps} · {r.view === 'mountain' ? 'Vista a la cordillera de Mikumi' : 'Entre los árboles'}</p>
                <p class="price rv rv-d2">{r.price ? <span>Desde US${r.price} <small>por noche</small></span> : <span>Tarifas a consultar</span>}</p>
                <p class="rv rv-d2">{t?.summary ?? r.summary}</p>
                <a class="link rv rv-d3" href={`/rooms/${r.slug}`}>Detalles y fotos (en inglés)</a>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section section--sand section--tight">
    <div class="wrap split--aside" style="display:grid">
      <div class="article">
        <h2 class="rv">Conviene saber</h2>
        <ul class="rv rv-d1">
          <li>Todas las tarifas reservadas directamente incluyen desayuno y cena en el restaurante. El almuerzo o cualquier comida extra cuesta US$15 por persona. Las bebidas se pagan aparte. En los paquetes de safari están incluidas todas las comidas.</li>
          <li>Los niños de 0 a 3 años no pagan, de 4 a 11 pagan la mitad de la tarifa de adulto y a partir de 12 pagan tarifa de adulto. Desayuno y cena están incluidos también para los niños; los menores de 4 años comen gratis. Los menores de 2 años no pueden participar en los recorridos de safari.</li>
          <li>Todos los alojamientos, tiendas de lujo incluidas, tienen aire acondicionado, baño privado y terraza privada.</li>
          <li>Wi-Fi en el restaurante y el bar. Las tiendas de lujo están, a propósito, sin conexión.</li>
          <li>Ofrecemos recogidas en la estación SGR de Morogoro, en Dar es Salaam y en el aeropuerto, con cargo.{offersActive && <span data-offer> El traslado desde Morogoro es gratis solo al reservar directamente con nosotros un safari de 2 días o más que empiece en noviembre de 2026 (con 3 o 4 días, también los billetes de tren SGR en clase económica de Dar es Salaam a Morogoro); solo a la ida, el regreso se cobra.</span>} Las comidas se sirven en el <a href="/restaurant">restaurante</a> (en inglés) frente a la cordillera de Mikumi.</li>
          <li>¿Quieren saber cómo nos comparamos con los lodges dentro del parque o los hoteles del pueblo de Mikumi? Lean <a href="/where-to-stay-in-mikumi">dónde alojarse en Mikumi</a> (en inglés).</li>
          <li>No se admiten mascotas. El campamento todavía no es accesible en silla de ruedas.</li>
        </ul>
      </div>
      <aside class="aside rv rv-d2">
        <h3>¿No saben cuál elegir?</h3>
        <p>Las parejas suelen tomar la Mountain View Cabin o una Luxury Mountain View Tent. Las familias, una Luxury Family Tent. Dígannos quiénes vienen y les sugerimos la opción adecuada.</p>
        <a class="btn" href={wa} rel="noopener">Consultar disponibilidad por WhatsApp</a>
        <p style="margin-top:12px;font-size:0.9rem">o <a href="/book">rellenen el formulario de solicitud</a> (en inglés)</p>
      </aside>
    </div>
  </section>

  <section class="section on-dark band">
    <div class="wrap">
      <h2 class="rv">Cena frente a la cordillera de Mikumi. Después, solo la sabana.</h2>
      <p class="lead rv rv-d1">Dígannos sus fechas y quiénes vienen. Respondemos {replyTime} con la disponibilidad, el precio total y una sugerencia de safari.</p>
      <div class="btn-row rv rv-d2">
        <a class="btn btn--fill" href={wa} rel="noopener">WhatsApp {site.phoneDisplay}</a>
        <a class="btn btn--light" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>
</Base>
