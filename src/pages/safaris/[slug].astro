---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import Price from '../../components/Price.astro';
import Photo from '../../components/Photo.astro';
import Wildlife from '../../components/Wildlife.astro';
import { safaris } from '../../data/safaris';
import Crumbs from '../../components/Crumbs.astro';
import { site } from '../../data/site';
import { offersActive } from '../../data/offers';

export function getStaticPaths() {
  return safaris.map((s) => ({ params: { slug: s.slug }, props: { safari: s } }));
}
const { safari } = Astro.props;
const others = safaris.filter((s) => s.slug !== safari.slug);
const galleries: Record<number, string[]> = {
  1: ['first-1', 'leopard-face', 'elephants-walk', 'giraffes-dusk', 'zebras-pair', 'buffalo-pair'],
  2: ['first-2', 'lions-tree', 'elephants-plain', 'giraffe-face', 'plains-herds', 'road-sunset'],
  3: ['first-3', 'cheetahs', 'elephants-storm', 'jeep-giraffes', 'wildebeest', 'own-giraffes'],
  4: ['first-4', 'lion-track', 'elephants-road', 'own-giraffe', 'zebras-hills', 'lion-pride'],
};

const title = safari.metaTitle ?? `${safari.name} | Camp Lilac, Mikumi`;
const trim = (t: string) => (t.length > 158 ? t.slice(0, 157).replace(/\s+\S*$/, '') + '…' : t);
const description = safari.metaDescription ?? trim(safari.summary);
const imgBase = safari.image.replace(/-(1600|2000)\.jpg$/, '');
const crumbs = [{ name: 'Safaris', href: '/safaris' }, { name: safari.name, href: `/safaris/${safari.slug}` }];
const offerId = safari.days >= 3 ? 'free-train-and-transfer' : 'free-transfer';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: safari.name,
  description: safari.summary,
  image: new URL(safari.image, site.url).href,
  url: `${site.url}/safaris/${safari.slug}`,
  touristType: ['Wildlife safari', 'Families', 'Couples'],
  itinerary: {
    '@type': 'ItemList',
    itemListElement: safari.itinerary.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.title, description: d.text })),
  },
  provider: { '@id': `${site.url}/#camp` },
  ...(safari.price && { offers: { '@type': 'Offer', price: safari.price, priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: `${site.url}/book?safari=${safari.slug}`, priceSpecification: { '@type': 'UnitPriceSpecification', price: safari.price, priceCurrency: 'USD', unitText: 'per person, park fees included' } } }),
};
---

<Base {title} {description} {schema} ogImage={safari.image} breadcrumbs={crumbs} dark>
  <section class="hero hero--inner">
    <div class="hero-media"><img src={`${imgBase}-1600.webp`} srcset={`${imgBase}-800.webp 800w, ${imgBase}-1200.webp 1200w, ${imgBase}-1600.webp 1600w`} sizes="100vw" alt={safari.imageAlt} width="1600" height="1200" fetchpriority="high" /></div>
    <div class="wrap hero-content">
      <div>
        <Crumbs items={crumbs} />
        <p class="label">{safari.days} {safari.days === 1 ? 'day' : 'days'} · {safari.bestFor}</p>
        <h1><span class="w"><span>{safari.name}</span></span></h1>
        <p class="lead">{safari.summary}</p>
      </div>
      <div class="hero-side"><b><Price price={safari.price} unit="person" /></b>Private 4×4 and guide<br />Starts and ends at the camp</div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap split--aside" style="display:grid">
      <div class="article">
        {offersActive && safari.offer && <p class="offer-note" data-offer><strong>November 2026 offer:</strong> {safari.offer} <a href={`/book?safari=${safari.slug}&offer=${offerId}`}>Claim this offer</a> · <a href="/offers">How the deals work</a></p>}
        {safari.variants && (
          <>
            <h2>Options</h2>
            <ul>{safari.variants.map((v) => <li><strong>{v.name}</strong>{v.price && <> — {v.price}</>}<br />{v.text}</li>)}</ul>
          </>
        )}
        <h2>Itinerary</h2>
        <ol class="itinerary">
          {safari.itinerary.map((d) => (
            <li>
              <h3>{d.title}</h3>
              <p>{d.text}</p>
              {(d.meals || d.stay) && <p class="meta">{d.meals && <span>Meals: {d.meals}</span>}{d.meals && d.stay && <br />}{d.stay && <span>Stay: {d.stay}</span>}</p>}
            </li>
          ))}
        </ol>
        {safari.tiers && (
          <>
            <h2>Price per person</h2>
            <table>
              <thead><tr><th scope="col">Group size</th><th scope="col">Price</th></tr></thead>
              <tbody>{safari.tiers.map((t) => <tr><th scope="row">{t.people}</th><td>US${t.price} per person</td></tr>)}</tbody>
            </table>
            <p>Private vehicle and guide for your group only. Park fees are included.</p>
          </>
        )}
        <h2>Included</h2>
        <ul>{safari.included.map((i) => <li>{i}</li>)}</ul>
        <h2>Not included</h2>
        <ul>{safari.excluded.filter((i) => offersActive || !/November 2026/.test(i)).map((i) => <li data-offer={/November 2026/.test(i) ? '' : undefined}>{i}</li>)}</ul>
        <p>
          Game drives are in an open-roof 4×4 with one of our own guides. We adjust timings to your train or flight and to the
          season. Children under 2 cannot join game drives. Dates are flexible — tell us when you want to come.
        </p>
        <h2>Getting to Mikumi for this safari</h2>
        <p>
          Every safari can start in Dar es Salaam or Zanzibar. The quickest comfortable way is the SGR train from Dar es Salaam to Morogoro (about 1.5 hours) and our 2-hour transfer to the camp; from Zanzibar you add the morning ferry or a short flight to Dar es Salaam. We organise the whole journey — tickets, pickups, ferries and flights — just tell us how you want to travel.
          Read more: <a href="/safari-from-dar-es-salaam">safari from Dar es Salaam</a>, <a href="/safari-from-zanzibar">safari from Zanzibar</a>, the <a href="/blog/dar-es-salaam-to-mikumi-by-sgr-train">step-by-step SGR train guide</a> and <a href="/getting-here">all the ways to get here</a>.
        </p>
      </div>
      <aside class="aside">
        <p class="aside-price"><Price price={safari.price} unit="person" /></p>
        <ul>
          <li>{safari.days} {safari.days === 1 ? 'day' : 'days'}</li>
          <li>Best for: {safari.bestFor}</li>
          <li>Private vehicle and guide</li>
          <li>Starts: {safari.start}</li>
        </ul>
        <a class="btn btn--fill" href={`/book?safari=${safari.slug}`}>Request this safari</a>
        <p style="margin-top:12px;font-size:0.9rem">or <a href={site.whatsapp}>message us on WhatsApp</a></p>
      </aside>
    </div>
  </section>

  <Wildlife label="On your game drives" title="What lives in Mikumi" pick={galleries[safari.days] ?? galleries[1]} />

  <section class="section section--sand">
    <div class="wrap">
      <h2 class="rv" style="margin-bottom:40px">Other safaris</h2>
      <div class="tiles tiles--3">
        {others.map((s, i) => (
          <a class={`tile rv rv-d${i}`} href={`/safaris/${s.slug}`}>
            <Photo src={s.image} alt={s.imageAlt} caption={`${s.days} ${s.days === 1 ? 'day' : 'days'}`} />
            <h3>{s.name}</h3>
            <p>{s.bestFor}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title={`Book the ${safari.name}`} />
</Base>
