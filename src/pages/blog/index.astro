---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import Photo from '../../components/Photo.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const title = 'Mikumi Safari Blog: Planning, Wildlife & Tips | Camp Lilac';
const description =
  'Practical articles about Mikumi National Park from the Camp Lilac team: SGR train travel, best time to visit, costs, wildlife, trips from Dar es Salaam and Zanzibar.';
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base {title} {description} breadcrumbs={[{ name: 'Blog', href: '/blog' }]}>
  <div class="wrap page-head">
    <p class="crumbs"><a href="/">Home</a> / Blog</p>
    <h1>The Mikumi blog</h1>
    <p class="lead">Written from the camp. Trip reports, planning guides and the things we wish every guest knew before arriving.</p>
  </div>
  <div class="wrap" style="padding-bottom:var(--section)">
    <ul class="post-list">
      {posts.map((p) => (
        <li>
          <div>
            <p class="meta">{fmt(p.data.pubDate)}{p.data.tags.length ? ` · ${p.data.tags.join(', ')}` : ''}</p>
            <h2 style="font-size:1.8rem"><a href={`/blog/${p.id}`}>{p.data.title}</a></h2>
            <p>{p.data.description}</p>
            <a href={`/blog/${p.id}`}>Read the article</a>
          </div>
          <a href={`/blog/${p.id}`}><Photo src={p.data.cover} alt={p.data.coverAlt} /></a>
        </li>
      ))}
    </ul>
  </div>
  <CtaBand />
</Base>
