---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';

const title = 'Restaurant & Bar with Mountain Views in Mikumi | Camp Lilac';
const description =
  'The Camp Lilac restaurant faces the Mikumi mountain ridge. All meals included for guests who book direct: fresh Tanzanian and international food, full bar and Wi-Fi.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'Camp Lilac Restaurant & Bar',
  servesCuisine: ['Tanzanian', 'International'],
  parentOrganization: { '@id': 'https://www.camp-lilac.com/#camp' },
  priceRange: '$$',
};
---
<Base {title} {description} {schema} breadcrumbs={[{ name: 'Restaurant', href: '/restaurant' }]} dark>
  <section class="hero hero--inner">
    <div class="hero-media"><img src="/images/rooms/restaurant-dusk-1600.webp" srcset="/images/rooms/restaurant-dusk-800.webp 800w, /images/rooms/restaurant-dusk-1600.webp 1600w" sizes="100vw" alt="The Camp Lilac restaurant at dusk, looking out to the Mikumi mountain ridge" width="1600" height="900" fetchpriority="high" /></div>
    <div class="wrap hero-content">
      <div>
        <p class="label">Restaurant &amp; bar</p>
        <h1><span class="w"><span>Every meal with&nbsp;</span></span><span class="w"><em style="color:#e4d9f7">the view</em></span></h1>
        <p class="lead">Our restaurant and bar look straight at the Mikumi mountain ridge. It is where the camp gathers at sunset, and the only dining room in Mikumi with this view.</p>
      </div>
      <div class="hero-side"><b>All meals</b>included when you<br />book direct</div>
    </div>
  </section>
  <section class="section section--tight">
    <div class="wrap split--aside" style="display:grid">
      <article class="article">
        <h2>All meals included</h2>
        <p>When you book direct, your stay is full board — breakfast, lunch and dinner. Breakfast means fresh fruit, eggs the way you like them, Tanzanian chapati and mandazi, good coffee and tea. Early safari? We serve it before first light.</p>
        <h2>Lunch and dinner</h2>
        <p>Lunch and dinner are cooked fresh each day — a mix of Tanzanian dishes (nyama choma, pilau, coconut fish, ugali with greens) and international favourites, with vegetarian options always available. Meals are charged per person per meal; tell us about allergies or dietary needs when you book. Children under 4 stay free and ages 4–11 are half price; meals for children are charged per meal.</p>
        <h2>The bar</h2>
        <p>Cold Kilimanjaro and Serengeti beers, Tanzanian Konyagi, a short wine list, soft drinks and fresh juice. The bar deck is the sunset spot. Wi-Fi is available here (the tents are intentionally offline).</p>
        <h2>Not staying with us?</h2>
        <p>Safari visitors and people passing through Mikumi are welcome for lunch or dinner with the view — please message us in advance so the kitchen is ready.</p>
      </article>
      <aside class="aside">
        <h3>Quick facts</h3>
        <ul><li>Full board for direct bookings</li><li>Drinks charged at the bar</li><li>Vegetarian options daily</li><li>Full bar, Wi-Fi</li><li>Mikumi mountain ridge view from every table</li></ul>
        <a class="btn btn--fill" href="/book">Book a stay</a>
      </aside>
    </div>
  </section>
  <CtaBand title="Dinner with the Mikumi mountain ridge view" />
</Base>
