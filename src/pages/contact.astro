---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const title = 'Contact Camp Lilac, Mikumi – WhatsApp, Email, Directions';
const description =
  'Contact Camp Lilac in Mikumi, Tanzania: WhatsApp +255 740 036 915, info@camp-lilac.com. Directions from Dar es Salaam and Morogoro SGR station, map, GPS and check-in times.';
const lat = site.geo.latitude, lng = site.geo.longitude;
const mapEmbed = `https://maps.google.com/maps?q=${lat},${lng}&z=13&hl=en&output=embed`;
---
<Base {title} {description} breadcrumbs={[{ name: 'Contact', href: '/contact' }]}>
  <div class="wrap page-head">
    <p class="crumbs"><a href="/">Home</a> / Contact</p>
    <h1>Contact Camp Lilac, Mikumi</h1>
    <p class="lead">Fastest is WhatsApp — we usually reply within the hour during the day, in English or Swahili.</p>
  </div>
  <div class="wrap split" style="padding-bottom:var(--section)">
    <div class="article">
      <h2>Talk to us</h2>
      <p><a href={site.whatsapp} rel="noopener">WhatsApp {site.phoneDisplay}</a><br /><a href={`tel:${site.phoneE164}`}>Call {site.phoneDisplay}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p><a href={site.instagram} rel="noopener">Instagram @camplilacmikumi</a> · <a href={site.facebook} rel="noopener">Facebook</a></p>
      <p>We answer booking requests {site.replyTime}, every day of the week. For same-day questions — a late train, a changed flight — WhatsApp is best.</p>

      <h2>Find us</h2>
      <address style="font-style:normal">
        <strong>Camp Lilac Mikumi</strong><br />
        {site.address.streetAddress}<br />
        Mikumi, Morogoro Region, Tanzania · postal code {site.address.postalCode}<br />
        GPS {Math.abs(lat).toFixed(4)}° S, {lng.toFixed(4)}° E
      </address>
      <p><a class="btn" href={site.mapsSearchUrl} rel="noopener">Open in Google Maps</a></p>
      <p>The camp is set about 2 km back from the Dar es Salaam–Mbeya highway, in the bush, facing the Mikumi mountain ridge, and is outside Mikumi National Park — minutes from the main gate. Follow our signs from the highway; the track is passable all year.</p>
      <div class="map-embed">
        <iframe src={mapEmbed} title="Map showing the location of Camp Lilac near Mikumi National Park" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      </div>

      <h2>How to reach us</h2>
      <ul>
        <li><strong>From Dar es Salaam:</strong> SGR train to Morogoro (about 1.5 hours), then our 2-hour transfer from the station — 3.5 hours in all. By road it is 5–6 hours. See <a href="/getting-here">getting here</a> and the <a href="/blog/dar-es-salaam-to-mikumi-by-sgr-train">step-by-step train guide</a>.</li>
        <li><strong>From Zanzibar:</strong> ferry or flight to Dar es Salaam, then the train. We organise the whole journey — see <a href="/safari-from-zanzibar">safari from Zanzibar</a>.</li>
        <li><strong>From the south</strong> (Iringa, Ruaha, Mbeya): we are just off the highway, a natural overnight stop. Buses stop in Mikumi town, where we can collect you.</li>
      </ul>
      <p>Check-in from {site.checkIn}, check-out {site.checkOut}. Early arrivals are welcome to leave bags and have lunch while the room is prepared.</p>
    </div>
    <aside class="aside">
      <h3>Want to book?</h3>
      <p>Use the booking form and we come back with availability, rates and a safari suggestion.</p>
      <a class="btn btn--fill" href="/book">Request a booking</a>
      <p style="margin-top:18px;font-size:0.9rem">Travel agents and tour operators: email <a href={`mailto:${site.email}`}>{site.email}</a> for trade rates and availability.</p>
    </aside>
  </div>
</Base>
