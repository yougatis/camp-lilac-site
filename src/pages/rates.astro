---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Offers from '../components/Offers.astro';
import { rooms } from '../data/rooms';
import { safaris } from '../data/safaris';
import { site } from '../data/site';

const title = 'Rates 2026–27: Luxury Tents & Cabins in Mikumi | Camp Lilac';
const description =
  'Camp Lilac nightly rates per room, breakfast and dinner included: luxury tents from US$140, cabins from US$160. Child policy, what\'s included, safari prices per person and direct-booking offers.';
---
<Base {title} {description} breadcrumbs={[{ name: 'Rates', href: '/rates' }]}>
  <div class="wrap page-head">
    <p class="crumbs"><a href="/">Home</a> / Rates</p>
    <h1>Rates &amp; what’s included</h1>
    <p class="lead">Simple pricing, no hidden extras. All room rates are per room per night and, when you book direct, include breakfast and dinner. Lunch or any extra meal is US$15 per person. Drinks are extra. Safari prices are per person and include park fees.</p>
  </div>

  <section class="section section--tight" style="padding-top:0">
    <div class="wrap split--aside" style="display:grid">
      <div class="article" style="max-width:none">
        <h2>Tents &amp; cabins — per room per night</h2>
        <table class="rates">
          <tr><th>Room</th><th>Sleeps</th><th>International rate</th></tr>
          {rooms.map((r) => (
            <tr><td><a href={`/rooms/${r.slug}`}>{r.name}</a>{r.units > 1 ? <span class="meta"> · {r.units} units</span> : ''}</td><td>{r.sleeps}</td><td class="price">{r.price ? `US$${r.price}` : 'On request'}</td></tr>
          ))}
        </table>
        <p class="meta">Tanzanian and East African residents: resident rates on request — message us with your dates. Rates may change on 1 July each year.</p>

        <h2>Children</h2>
        <table class="rates">
          <tr><th>Age</th><th>Rate</th><th>Meals</th></tr>
          <tr><td>0–3</td><td>Free</td><td>All meals free</td></tr>
          <tr><td>4–11</td><td>50% of the adult rate</td><td>Breakfast &amp; dinner included; lunch US$15</td></tr>
          <tr><td>12 and over</td><td>Adult rate</td><td>Breakfast &amp; dinner included; lunch US$15</td></tr>
        </table>

        <h2>Safaris — per person</h2>
        <table class="rates">
          <tr><th>Package</th><th>Days</th><th>1 person</th><th>2 or more</th></tr>
          {safaris.map((s) => (
            <tr><td><a href={`/safaris/${s.slug}`}>{s.name}</a></td><td>{s.days}</td><td class="price">{s.tiers ? `US$${s.tiers[0].price}` : '—'}</td><td class="price">{s.tiers ? `US$${s.tiers[s.tiers.length - 1].price}` : '—'}</td></tr>
          ))}
        </table>
        <p class="meta">1-day safari from Dar es Salaam by SGR train (same day): from US$230 per person for 2 or more. Multi-day prices include the nights at Camp Lilac and start with the SGR train from Dar es Salaam.</p>

        <h2>Included in every stay</h2>
        <ul>
          <li>Breakfast and dinner in the restaurant (direct bookings)</li><li>All meals on safari packages (full board)</li>
          <li>Air conditioning, private bathroom and private deck in every tent and cabin</li>
          <li>Wi-Fi at the restaurant and bar</li>
          <li>Parking</li>
        </ul>
        <h2>Included in every safari</h2>
        <ul>
          <li>Mikumi National Park entry fees (US$35.40 per adult per day — paid by us)</li>
          <li>Private open-roof 4×4 for your group only, with our own guide</li>
          <li>Meals as listed day by day, water and soft drinks</li>
          <li>Accommodation at Camp Lilac on multi-day safaris</li>
        </ul>
        <h2>Not included</h2>
        <ul>
          <li>Lunch or any extra meal on room-only stays — US$15 per person</li><li>Drinks — soft drinks, beer, wine and spirits from the bar</li>
          <li>Transfers unless stated — 2-day safari: free one-way transfer Morogoro → Mikumi; 3+ days: free one-way train ticket from Dar + transfer. Return journeys are charged.</li>
          <li>Alcoholic drinks, tips, travel insurance</li>
        </ul>
        <h2>Booking &amp; payment</h2>
        <ul>
          <li>Request a quote — nothing to pay to enquire. We reply {site.replyTime} with availability; a deposit then secures your booking.</li>
          <li>Cash and card accepted at the camp. Deposits can be paid online by card through a secure payment link we send you.</li>
          <li>Check-in from {site.checkIn}, check-out {site.checkOut}.</li>
        </ul>
      </div>
      <aside class="aside">
        <h3>Get an exact price</h3>
        <p>Tell us your dates, who is coming and which safari. We send one number with everything included.</p>
        <a class="btn btn--fill" href="/book">Request a quote</a>
        <p style="margin:14px 0 0;font-size:0.9rem;text-align:center">or <a href={site.whatsapp} rel="noopener" style="border-bottom:1px solid var(--lilac)">WhatsApp us</a></p>
      </aside>
    </div>
  </section>

  <Offers compact />
  <CtaBand />
</Base>
