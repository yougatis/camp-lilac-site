---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Thank you – Camp Lilac" description="We received your request and will reply shortly." noindex>
  <div class="wrap page-head" style="min-height:50vh">
    <h1>Thank you — we have your request</h1>
    <p class="lead">We reply by email the same day with availability and rates. In a hurry? <a href={site.whatsapp}>WhatsApp {site.phoneDisplay}</a>.</p>
    <a class="link" href="/mikumi-national-park">Read the Mikumi guide while you wait</a>
  </div>
</Base>
