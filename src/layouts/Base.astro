---
import { site, nav } from '../data/site';
import { reviewScore, sources } from '../data/reviews';
import { offersActive, OFFER_END } from '../data/offers';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  breadcrumbs?: { name: string; href: string }[];
  dark?: boolean; // true when the page starts with a full-bleed photo hero (transparent light nav)
  lang?: string; // page language (default 'en'); translated pages pass 'it', 'fr', …
  alternates?: { lang: string; href: string }[]; // hreflang set for translated pages (include the page itself; 'en' is x-default)
}

const { title, description, canonical, ogImage = site.defaultOgImage, ogType = 'website', schema, noindex = false, breadcrumbs, dark = false, lang = 'en', alternates } = Astro.props;

// With build.format 'file', Astro.url.pathname ends in ".html" at build time; Cloudflare serves the clean
// URL and redirects the .html one, so the canonical must always be the clean path.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonicalUrl = canonical ?? new URL(cleanPath, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
const isHome = cleanPath === '/';
const ogLocale = { en: 'en_GB', it: 'it_IT', fr: 'fr_FR', de: 'de_DE', pl: 'pl_PL' }[lang] ?? 'en_GB';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['LodgingBusiness', 'Hotel'],
  '@id': `${site.url}/#camp`,
  name: site.schemaName,
  alternateName: site.name,
  legalName: site.legalName,
  url: site.url,
  logo: new URL('/images/logo-round.png', site.url).href,
  image: site.schemaImages.map((i) => new URL(i, site.url).href),
  description: site.schemaDescription,
  telephone: site.phoneE164,
  email: site.email,
  address: { '@type': 'PostalAddress', ...site.address },
  geo: { '@type': 'GeoCoordinates', ...site.geo },
  hasMap: site.mapsUrl,
  checkinTime: site.checkIn,
  checkoutTime: site.checkOut,
  priceRange: site.priceRange,
  currenciesAccepted: 'USD, TZS',
  paymentAccepted: 'Cash, Credit Card',
  petsAllowed: false,
  numberOfRooms: site.units,
  availableLanguage: site.languages,
  amenityFeature: site.amenities.map((a) => ({ '@type': 'LocationFeatureSpecification', name: a, value: true })),
  areaServed: { '@type': 'Place', name: 'Mikumi National Park, Morogoro Region, Tanzania' },
  sameAs: [site.instagram, site.facebook, site.tripadvisorCamp, site.tripadvisorSafari, site.safariBookings, site.mapsUrl, site.bookingCom].filter(Boolean),
};

const breadcrumbSchema = breadcrumbs && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(b.href, site.url).href })),
};

const schemas = [orgSchema, breadcrumbSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])].filter(Boolean);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    {alternates?.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, site.url).href} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(alternates.find((a) => a.lang === 'en')?.href ?? alternates[0].href, site.url).href} />}
    <meta name="theme-color" content="#10263a" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.schemaName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preload" href="/fonts/cormorant-garamond-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jost-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {offersActive && <script is:inline define:vars={{ offerEnd: OFFER_END }}>if (Date.now() > Date.parse(offerEnd + 'T23:59:59+03:00')) document.documentElement.classList.add('offers-over');</script>}
    <noscript><style>.preloader{display:none}body.is-loading{overflow:auto}.rv{opacity:1;transform:none}.hero h1 .w span{transform:none}.hero-side{opacity:1;transform:none}</style></noscript>
  </head>
  <body class={isHome ? 'is-loading' : ''}>
    {isHome && <div class="preloader" id="preloader" aria-hidden="true">
      <div class="inner">
        <img class="mark" src="/images/bird-circle.webp" alt="" width="480" height="480" />
        <div class="wm" style="aspect-ratio:805/208">
          <img src="/images/wm/c0.png" alt="" style="left:1.24%;width:8.70%;animation-delay:0.23s" />
          <img src="/images/wm/c1.png" alt="" style="left:13.66%;width:8.94%;animation-delay:0.27s" />
          <img src="/images/wm/c2.png" alt="" style="left:25.47%;width:11.80%;animation-delay:0.30s" />
          <img src="/images/wm/c3.png" alt="" style="left:40.37%;width:7.08%;animation-delay:0.34s" />
          <img src="/images/wm/c4.png" alt="" style="left:57.27%;width:6.83%;animation-delay:0.39s" />
          <img src="/images/wm/c5.png" alt="" style="left:67.58%;width:2.61%;animation-delay:0.42s" />
          <img src="/images/wm/c6.png" alt="" style="left:73.17%;width:3.85%;animation-delay:0.47s" />
          <img src="/images/wm/c7.png" alt="" style="left:80.37%;width:8.20%;animation-delay:0.51s" />
          <img src="/images/wm/c8.png" alt="" style="left:91.93%;width:6.83%;animation-delay:0.55s" />
        </div>
        <div class="wm-sub" style="aspect-ratio:650/220">
          <img src="/images/wm/m0.png" alt="" style="left:8.31%;width:17.38%;animation-delay:0.65s" />
          <img src="/images/wm/m1.png" alt="" style="left:30.15%;width:3.54%;animation-delay:0.68s" />
          <img src="/images/wm/m2.png" alt="" style="left:38.15%;width:9.69%;animation-delay:0.71s" />
          <img src="/images/wm/m3.png" alt="" style="left:52.31%;width:10.77%;animation-delay:0.74s" />
          <img src="/images/wm/m4.png" alt="" style="left:67.54%;width:15.38%;animation-delay:0.77s" />
          <img src="/images/wm/m5.png" alt="" style="left:87.38%;width:3.38%;animation-delay:0.80s" />
        </div>
      </div>
      <div class="sub">A luxury tented camp · Tanzania</div>
    </div>}

    <a class="skip" href="#main">Skip to content</a>
    <header class={`site-header${dark ? '' : ' on-light'}`} id="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="Camp Lilac home">
          <img class="wide" src="/images/logo-wide.png" alt="Camp Lilac" width="156" height="44" />
        </a>
        <a class="badge" href={reviewScore.url} rel="noopener" title={sources.map((s) => `${s.platform} ${s.score}/5 (${s.count})`).join(' · ')}><img src="/images/logo-google.png" alt="Google" width="18" height="18" /><img src="/images/logo-tripadvisor.png" alt="Tripadvisor" width="22" height="22" class="ta" /><img src="/images/logo-safaribookings.png" alt="SafariBookings" width="18" height="18" class="sb" /><span class="stars">★★★★★</span><b>{reviewScore.score} / 5</b> · {reviewScore.count} reviews</a>
        <nav class="main-nav" aria-label="Main">
          <button class="nav-toggle" aria-expanded="false" aria-controls="nav-list">Menu</button>
          <ul id="nav-list">
            {nav.map((n) => (
              <li><a href={n.href} aria-current={cleanPath === n.href || (n.href !== '/' && cleanPath.startsWith(n.href + '/')) || (n.match && n.match.some((m) => cleanPath.startsWith(m))) ? 'page' : undefined}>{n.label}</a></li>
            ))}
            <li class="nav-wa"><a href={site.whatsapp} rel="noopener" aria-label="WhatsApp us"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.5 4.1 1.6 5.9L0 24l6.5-1.7a11.8 11.8 0 0 0 5.6 1.4c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.2-6.1-3.4-8.4zM12.1 21.7c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.8 1 1-3.7-.2-.4a9.8 9.8 0 0 1-1.5-5.2c0-5.4 4.4-9.8 9.9-9.8 2.6 0 5.1 1 6.9 2.9a9.7 9.7 0 0 1 2.9 6.9c0 5.4-4.4 9.9-9.8 9.9zm5.4-7.3c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.4-1.5-.9-.8-1.5-1.8-1.6-2.1-.2-.3 0-.5.1-.6l.4-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4z"/></svg><span>WhatsApp</span></a></li>
            <li class="nav-cta"><a href="/book">Plan my stay</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <a class="wa-float" href={site.whatsapp} rel="noopener" aria-label="Chat on WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.5 4.1 1.6 5.9L0 24l6.5-1.7a11.8 11.8 0 0 0 5.6 1.4c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.2-6.1-3.4-8.4zM12.1 21.7c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.8 1 1-3.7-.2-.4a9.8 9.8 0 0 1-1.5-5.2c0-5.4 4.4-9.8 9.9-9.8 2.6 0 5.1 1 6.9 2.9a9.7 9.7 0 0 1 2.9 6.9c0 5.4-4.4 9.9-9.8 9.9zm5.4-7.3c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.4-1.5-.9-.8-1.5-1.8-1.6-2.1-.2-.3 0-.5.1-.6l.4-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4z"/></svg></a>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <svg class="ridge" viewBox="0 0 1600 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0 70 C 200 50, 320 20, 480 40 S 760 10, 920 30 S 1200 0, 1600 40 L1600 90 L0 90Z" fill="#1f4e6e"/></svg>
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <img src="/images/logo-wide.png" alt="Camp Lilac Mikumi" width="220" height="62" loading="lazy" />
          <p>Luxury tented safari camp just outside Mikumi National Park, Morogoro Region, Tanzania.</p>
          <p><a href={site.mapsUrl} rel="noopener">{Math.abs(site.geo.latitude).toFixed(4)}° S · {site.geo.longitude.toFixed(4)}° E</a></p>
        </div>
        <div>
          <h4>Stay</h4>
          <a href="/rooms">Tents &amp; cabins</a>
          <a href="/rates">Rates</a>
          <a href="/offers">{offersActive ? 'Safari deals' : 'Book direct benefits'}</a>
          <a href="/restaurant">Restaurant &amp; bar</a>
          <a href="/about">About the camp</a>
          <a href="/book">Check availability</a>
          <a href="/faq">Questions</a>
        </div>
        <div>
          <h4>Mikumi</h4>
          <a href="/safaris">Safari packages</a>
          <a href="/safari-from-dar-es-salaam">Safari from Dar es Salaam</a>
          <a href="/safari-from-zanzibar">Safari from Zanzibar</a>
          <a href="/it/safari-da-zanzibar" hreflang="it" lang="it">Safari da Zanzibar (italiano)</a>
          <a href="/mikumi-national-park">Mikumi National Park guide</a>
          <a href="/where-to-stay-in-mikumi">Where to stay in Mikumi</a>
          <a href="/getting-here">Getting here</a>
          <a href="/blog">Blog</a>
        </div>
        <div>
          <h4>Contact</h4>
          <a href={site.whatsapp} rel="noopener">WhatsApp {site.phoneDisplay}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.instagram} rel="noopener">Instagram</a>
          <a href={site.facebook} rel="noopener">Facebook</a>
        </div>
        <div>
          <h4>Reviews</h4>
          {sources.map((s) => <a href={s.url} rel="noopener">{s.platform} {s.score}/5 · {s.count}</a>)}
        </div>
      </div>
      <div class="wrap footer-legal">
        <span>© {new Date().getFullYear()} {site.legalName}</span>
        <span>Check-in {site.checkIn} · Check-out {site.checkOut}</span>
      </div>
    </footer>

    <script>
      // Preloader (home page only, once per session): waits for the hero photo, with a floor of 1 s and a hard cap
      // of 1.7 s so nobody on a slow connection stares at a blank screen. Skipped on 2G/3G, data-saver and reduced motion.
      const pre = document.getElementById('preloader');
      const body = document.body;
      const hero = document.querySelector('.hero');
      const seen = (() => { try { return sessionStorage.getItem('cl-pre'); } catch { return '1'; } })();
      const conn = (navigator as any).connection;
      const slow = !!(conn && (conn.saveData || /(^|[^4-9])[23]g/.test(conn.effectiveType || '')));
      const skipPre = () => { pre?.remove(); body.classList.remove('is-loading'); requestAnimationFrame(() => hero?.classList.add('revealed')); };
      const finish = () => {
        pre?.classList.add('done');
        body.classList.remove('is-loading');
        requestAnimationFrame(() => hero?.classList.add('revealed'));
        try { sessionStorage.setItem('cl-pre', '1'); } catch {}
      };
      if (!pre || seen || slow || matchMedia('(prefers-reduced-motion: reduce)').matches) skipPre();
      else {
        const t0 = performance.now();
        let done = false;
        const go = () => { if (done) return; done = true; setTimeout(finish, Math.max(0, 1000 - (performance.now() - t0))); };
        const heroImg = hero?.querySelector<HTMLImageElement>('.hero-media img');
        if (!heroImg || heroImg.complete) go();
        else { heroImg.addEventListener('load', go, { once: true }); heroImg.addEventListener('error', go, { once: true }); }
        setTimeout(go, 1700);
      }

      // Header: transparent over hero, solid after scrolling.
      const header = document.getElementById('site-header');
      const onScroll = () => header?.classList.toggle('solid', scrollY > (hero ? innerHeight * 0.75 : 10));
      onScroll(); addEventListener('scroll', onScroll, { passive: true });

      // Mobile nav
      const btn = document.querySelector('.nav-toggle');
      const list = document.getElementById('nav-list');
      btn?.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        btn.textContent = open ? 'Menu' : 'Close';
        list?.classList.toggle('open', !open);
        body.classList.toggle('nav-open', !open);
      });

      // Reveal on scroll
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
      document.querySelectorAll('.rv').forEach((el) => io.observe(el));

      // Drag-to-scroll galleries (mouse) + arrow buttons; touch uses native swipe
      document.querySelectorAll<HTMLElement>('.gallery').forEach((g) => {
        let down = false, moved = false, startX = 0, left = 0;
        g.addEventListener('pointerdown', (e) => {
          if (e.pointerType !== 'mouse') return;
          down = true; moved = false; startX = e.clientX; left = g.scrollLeft;
          g.classList.add('dragging'); e.preventDefault();
        });
        window.addEventListener('pointermove', (e) => {
          if (!down) return;
          const dx = e.clientX - startX; if (Math.abs(dx) > 4) moved = true;
          g.scrollLeft = left - dx;
        });
        const end = () => { if (!down) return; down = false; g.classList.remove('dragging'); };
        window.addEventListener('pointerup', end);
        window.addEventListener('pointercancel', end);
        g.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
        g.addEventListener('dragstart', (e) => e.preventDefault());
        const wrap = g.parentElement;
        const nav = wrap?.querySelector<HTMLElement>('.gallery-nav');
        if (nav) {
          const step = () => (g.querySelector<HTMLElement>('.ph')?.offsetWidth ?? 600) + 18;
          nav.querySelector('.prev')?.addEventListener('click', () => g.scrollBy({ left: -step(), behavior: 'smooth' }));
          nav.querySelector('.next')?.addEventListener('click', () => g.scrollBy({ left: step(), behavior: 'smooth' }));
        }
      });

      // Lightbox: click any photo in a wildlife grid or room gallery to view it large
      (() => {
        const groups = document.querySelectorAll<HTMLElement>('.wild-grid, .gallery');
        if (!groups.length) return;
        const lb = document.createElement('div');
        lb.className = 'lightbox';
        lb.setAttribute('role', 'dialog');
        lb.setAttribute('aria-modal', 'true');
        lb.setAttribute('aria-label', 'Photo viewer');
        lb.innerHTML = '<button class="lb-close" aria-label="Close">×</button><button class="lb-prev" aria-label="Previous photo">‹</button><figure class="lb-fig"><img alt="" /><figcaption></figcaption></figure><button class="lb-next" aria-label="Next photo">›</button><div class="lb-count"></div>';
        document.body.appendChild(lb);
        const img = lb.querySelector('img')!, cap = lb.querySelector('figcaption')!, count = lb.querySelector<HTMLElement>('.lb-count')!;
        let items: { src: string; alt: string }[] = [], idx = 0, lastFocus: Element | null = null;
        const show = (i: number) => {
          idx = (i + items.length) % items.length;
          img.src = items[idx].src; img.alt = items[idx].alt; cap.textContent = items[idx].alt;
          count.textContent = `${idx + 1} / ${items.length}`;
        };
        const open = (list: typeof items, i: number) => {
          items = list; lastFocus = document.activeElement; show(i);
          lb.classList.add('open'); document.documentElement.style.overflow = 'hidden';
          lb.querySelector<HTMLElement>('.lb-next')?.focus();
        };
        const close = () => { lb.classList.remove('open'); document.documentElement.style.overflow = ''; (lastFocus as HTMLElement | null)?.focus?.(); };
        groups.forEach((g) => {
          const figs = [...g.querySelectorAll<HTMLElement>('figure.ph')];
          const list = figs.map((f) => { const im = f.querySelector('img')!; return { src: im.getAttribute('src') || im.currentSrc, alt: im.alt }; });
          figs.forEach((f, i) => {
            f.classList.add('lb-trigger'); f.tabIndex = 0; f.setAttribute('role', 'button'); f.setAttribute('aria-label', `View photo ${i + 1} of ${figs.length} larger`);
            f.addEventListener('click', (e) => { if (e.defaultPrevented) return; open(list, i); });
            f.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(list, i); } });
          });
        });
        lb.querySelector('.lb-close')!.addEventListener('click', close);
        lb.querySelector('.lb-prev')!.addEventListener('click', () => show(idx - 1));
        lb.querySelector('.lb-next')!.addEventListener('click', () => show(idx + 1));
        lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
        document.addEventListener('keydown', (e) => {
          if (!lb.classList.contains('open')) return;
          if (e.key === 'Escape') close(); else if (e.key === 'ArrowRight') show(idx + 1); else if (e.key === 'ArrowLeft') show(idx - 1);
        });
        let sx = 0;
        lb.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
        lb.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 40) show(idx + (dx < 0 ? 1 : -1)); });
      })();
    </script>
  </body>
</html>
