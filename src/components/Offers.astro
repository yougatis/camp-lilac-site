---
// Direct-booking deals band. Wording lives in src/data/offers.ts.
import { offers } from '../data/offers';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<section class={`section ${compact ? 'section--tight' : ''} section--sand`}>
  <div class="wrap">
    <p class="label rv" style="color:var(--lilac-deep);margin-bottom:12px">Book direct</p>
    <h2 class="rv" style="margin-bottom:36px">Two deals when you book <em>with us</em></h2>
    <div class="offers">
      {offers.map((o, i) => (
        <div class={`offer rv rv-d${i + 1}`}>
          <p class="label" style="margin:0 0 10px">{o.who}</p>
          <h3>{o.title}</h3>
          <p class="worth">{o.worth}</p>
          <p>{o.text}</p>
          <a class="btn btn--fill" href={`/book?safari=${o.safari}&offer=${o.id}`}>Claim this offer</a>
        </div>
      ))}
    </div>
    <div class="btn-row rv rv-d3"><a class="link" href="/offers">How the offers work</a></div>
  </div>
</section>
