---
// Direct-booking deals. Edit the text here; it shows on the home page and the safaris page.
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const offers = [
  { title: '2-day safari: free transfer to Mikumi', text: 'Book a 2-day safari with us and we pick you up at Morogoro SGR station and drive you to Mikumi for free. One way — the return transfer to Morogoro is charged.' },
  { title: '3+ day safari: free train ticket and transfer', text: 'Book a safari of 3 days or more and we pay your SGR train ticket from Dar es Salaam to Morogoro and the transfer on to Mikumi. One way — the return journey is charged.' },
];
---
<section class={`section ${compact ? 'section--tight' : ''} section--sand`}>
  <div class="wrap">
    <p class="label rv" style="color:var(--lilac-deep);margin-bottom:12px">Book direct</p>
    <h2 class="rv" style="margin-bottom:36px">Two deals when you book <em>with us</em></h2>
    <div class="offers">
      {offers.map((o, i) => (
        <div class={`offer rv rv-d${i + 1}`}>
          <h3>{o.title}</h3>
          <p>{o.text}</p>
        </div>
      ))}
    </div>
    <div class="btn-row rv rv-d3"><a class="btn btn--fill" href="/safaris">See the safaris</a></div>
  </div>
</section>
