---
const items = ['All meals included', 'Air-conditioned tents & cabins', 'Our own guides & 4×4s', 'The only Mikumi mountain ridge view', 'Quiet — away from the highway', 'Minutes from the park gate'];
---
<div class="ribbon" aria-hidden="true">
  <div class="ribbon-track">
    {[...items, ...items].map((t) => <span>{t}</span>)}
  </div>
</div>
