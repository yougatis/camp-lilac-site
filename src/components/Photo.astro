---
interface Props { src: string; alt: string; caption?: string; ratio?: 'portrait' | 'landscape' | 'square' | 'wide'; loading?: 'lazy' | 'eager'; class?: string; zoom?: boolean; sizes?: string }
const { src, alt, caption, ratio = 'landscape', loading = 'lazy', class: cls = '', zoom = false, sizes = '(max-width: 760px) 100vw, 50vw' } = Astro.props;
const base = src.replace(/-(1600|2000|1200)\.jpg$/, '').replace(/\.(jpg|png|svg)$/, '');
const isPhoto = src.startsWith('/images/rooms/');
---
<figure class={`ph ph--${ratio} ${zoom ? 'zoom' : ''} ${cls}`}>
  {isPhoto ? (
    <picture>
      <source type="image/webp" srcset={`${base}-800.webp 800w, ${base}-1600.webp 1600w`} sizes={sizes} />
      <img src={`${base}-1600.webp`} alt={alt} loading={loading} decoding="async" width="1600" height="1200" />
    </picture>
  ) : (
    <img src={src} alt={alt} loading={loading} decoding="async" />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
